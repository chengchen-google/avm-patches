From 90e4661252a3d0a807f9280a53696891a32dea30 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Wed, 19 Aug 2026 16:16:17 -0500
Subject: [PATCH] Speed 1: enable transform statistics pruning

---
 av2/encoder/speed_features.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/av2/encoder/speed_features.c b/av2/encoder/speed_features.c
index 820b2f9b6..dec690e47 100644
--- a/av2/encoder/speed_features.c
+++ b/av2/encoder/speed_features.c
@@ -218,6 +218,13 @@ static void set_good_speed_feature_framesize_dependent(
     }
   }
 
+  // The frame-level transform statistics already drive a conservative
+  // transform-type shortlist at faster presets.  Exercise the same existing
+  // policy at speed 1 without changing any other preset.
+  if (speed == 1 && is_480p_or_larger) {
+    sf->tx_sf.tx_type_search.prune_tx_type_using_stats = 1;
+  }
+
   if (speed >= 4) {
     if (is_720p_or_larger) {
       sf->part_sf.partition_search_breakout_dist_thr = (1 << 26);
-- 
2.51.1

