diff --git a/av2/encoder/pickccso.c b/av2/encoder/pickccso.c
index a5898421a8382889f4a88002323e33994343089a..b675fb15dd5f0e58bb6861187c830ad466e06e54 100644
--- a/av2/encoder/pickccso.c
+++ b/av2/encoder/pickccso.c
@@ -62,6 +62,18 @@ typedef struct {
 const int ccso_offset[8] = { -10, -7, -3, -1, 0, 1, 3, 7 };
 const int ccso_scale[4] = { 1, 2, 3, 4 };
 
+// Preserve the existing CCSO search tolerance on intra and low-pyramid-level
+// reference frames. On higher-pyramid-level inter frames, require a candidate
+// to improve the running best by about 1% before continuing the search.
+#define CCSO_EARLY_TERM_REFERENCE_TOLERANCE 1.001
+#define CCSO_EARLY_TERM_LEAF_TOLERANCE 1.01
+
+static INLINE double ccso_early_term_tolerance(const AV2_COMMON *cm) {
+  return !frame_is_intra_only(cm) && cm->current_frame.pyramid_level > 2
+             ? CCSO_EARLY_TERM_LEAF_TOLERANCE
+             : CCSO_EARLY_TERM_REFERENCE_TOLERANCE;
+}
+
 static INLINE bool reuse_ccso_class_info(const AV2_COMMON *cm) {
   return !(cm->bru.enabled);
 }
@@ -1237,6 +1249,7 @@ static void derive_ccso_filter(CcsoCtx *ctx, AV2_COMMON *cm, const int plane,
   memset(src_cls1, 0,
          sizeof(*src_cls1) * xd->plane[0].dst.height * xd->plane[0].dst.width);
   const int is_intra_frame = frame_is_intra_only(cm);
+  const double early_term_tolerance = ccso_early_term_tolerance(cm);
   int check_ccso = 0;
 
   RefCntBuffer *ref_frame = NULL;
@@ -1609,7 +1622,7 @@ static void derive_ccso_filter(CcsoCtx *ctx, AV2_COMMON *cm, const int plane,
               }
               if (early_terminate_ccso_search &&
                   final_filtered_cost != UINT64_MAX &&
-                  1.001 * final_filtered_cost > last_best_cost)
+                  early_term_tolerance * final_filtered_cost > last_best_cost)
                 goto exit_loops;
             }
           }
