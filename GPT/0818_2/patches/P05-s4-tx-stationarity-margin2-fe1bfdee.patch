+enum { TX_PART_STATIONARITY_STRIPS = 4 };
+
+// The measured margin-2 operating point accepts a strongest strip up to 1.5x
+// the mean. Keep that decision threshold fixed for this standalone arm.
+static AVM_INLINE int tx_partition_stationarity_margin(void) { return 2; }
+
+// Measure whether residual magnitude is distributed evenly across strips on
+// each axis. The walk is subsampled for transforms at least 16 pixels wide or
+// high because the result is only used as a search gate.
+static AVM_INLINE void measure_residual_stationarity(
+    const MACROBLOCK *x, BLOCK_SIZE plane_bsize, int blk_row, int blk_col,
+    TX_SIZE max_tx_size, int margin, int *stationary_rows,
+    int *stationary_cols) {
+  *stationary_rows = 0;
+  *stationary_cols = 0;
+
+  const int txw = tx_size_wide[max_tx_size];
+  const int txh = tx_size_high[max_tx_size];
+  if (txw < TX_PART_STATIONARITY_STRIPS * 2 ||
+      txh < TX_PART_STATIONARITY_STRIPS * 2) {
+    return;
+  }
+
+  const struct macroblock_plane *const p = &x->plane[0];
+  const int diff_stride = block_size_wide[plane_bsize];
+  const int16_t *const diff =
+      &p->src_diff[(blk_row * diff_stride + blk_col) << MI_SIZE_LOG2];
+  const int step_y = txh >= 16 ? 2 : 1;
+  const int step_x = txw >= 16 ? 2 : 1;
+  const int strip_h = txh / TX_PART_STATIONARITY_STRIPS;
+  const int strip_w = txw / TX_PART_STATIONARITY_STRIPS;
+
+  uint64_t row_magnitude[TX_PART_STATIONARITY_STRIPS] = { 0 };
+  uint64_t col_magnitude[TX_PART_STATIONARITY_STRIPS] = { 0 };
+  uint64_t total = 0;
+
+  for (int i = 0; i < txh; i += step_y) {
+    const int16_t *const row = diff + (ptrdiff_t)i * diff_stride;
+    const int strip_i =
+        AVMMIN(i / strip_h, TX_PART_STATIONARITY_STRIPS - 1);
+    for (int j = 0; j < txw; j += step_x) {
+      const uint64_t magnitude = (uint64_t)abs((int)row[j]);
+      row_magnitude[strip_i] += magnitude;
+      col_magnitude[AVMMIN(j / strip_w,
+                           TX_PART_STATIONARITY_STRIPS - 1)] += magnitude;
+      total += magnitude;
+    }
+  }
+
+  if (total == 0) {
+    *stationary_rows = 1;
+    *stationary_cols = 1;
+    return;
+  }
+
+  const uint64_t mean = total / TX_PART_STATIONARITY_STRIPS;
+  uint64_t max_row = 0;
+  uint64_t max_col = 0;
+  for (int s = 0; s < TX_PART_STATIONARITY_STRIPS; ++s) {
+    max_row = AVMMAX(max_row, row_magnitude[s]);
+    max_col = AVMMAX(max_col, col_magnitude[s]);
+  }
+
+  const uint64_t bound = mean * (margin + 1);
+  *stationary_rows = max_row * margin <= bound;
+  *stationary_cols = max_col * margin <= bound;
+}
+
+static AVM_INLINE int tx_partition_cuts_stationary_axis(
+    TX_PARTITION_TYPE type, int stationary_rows, int stationary_cols) {
+  switch (type) {
+    case TX_PARTITION_HORZ:
+    case TX_PARTITION_HORZ4:
+    case TX_PARTITION_HORZ5: return stationary_rows;
+    case TX_PARTITION_VERT:
+    case TX_PARTITION_VERT4:
+    case TX_PARTITION_VERT5: return stationary_cols;
+    case TX_PARTITION_SPLIT: return stationary_rows && stationary_cols;
+    default: return 0;
+  }
+}
